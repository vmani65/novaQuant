// =============================================================================
// rollOverTrigger.afl
// Chart  : Nifty-i  |  Timeframe: 1 Minute
// Purpose: Fire a rollover trigger to NovaQuant at exactly 14:47 IST daily.
//          Passes the current Nifty close price. Triggers only once per day.
// Endpoint: GET http://localhost:8080/api/rollover-trigger?currentPrice=<price>
// Model  : Fire-and-forget (no response expected)
// =============================================================================

_SECTION_BEGIN("RollOver Trigger");

SetBarsRequired(sbrAll, 0);

NOVA_HOST      = "http://localhost:8080";
TRIGGER_HOUR   = 14;
TRIGGER_MIN    = 47;
STATIC_VAR_KEY = "RollOverTrigger_LastFiredDate";

// Only evaluate on the real-time (last) bar — skips all historical bars
if (Status("LastBarOnChart")) {

    barHour = LastValue(Hour());
    barMin  = LastValue(Minute());
    barDate = LastValue(DateNum());  // YYYYMMDD e.g. 20260325

    isTriggerTime  = (barHour == TRIGGER_HOUR) AND (barMin == TRIGGER_MIN);
    alreadyFiredToday = (StaticVarGet(STATIC_VAR_KEY) == barDate);

    if (isTriggerTime AND NOT alreadyFiredToday) {

        priceStr   = StrFormat("%.2f", LastValue(Close));
        requestURL = NOVA_HOST + "/api/rollover-trigger?currentPrice=" + priceStr;

        // Lock immediately to block any re-entry within the same bar
        StaticVarSet(STATIC_VAR_KEY, barDate);

        // Fire-and-forget: ShellExecute is async — AFL returns immediately.
        // cmd.exe /c runs curl as a subprocess; showcmd=0 hides the window.
        // curl.exe is built into Windows 10 v1803+ at C:\Windows\System32\
        // -s  : silent (no progress bar)
        // -o NUL : discard response body
        ShellExecute("cmd.exe", "/c curl.exe -s -o NUL " + requestURL, "", 0);

        _TRACE("RollOver Trigger FIRED | price=" + priceStr);
    }
}

// ---------------------------------------------------------------------------
// Chart display
// ---------------------------------------------------------------------------
Plot(Close, "NIFTY-I", colorDefault, styleCandle);

firedToday = (StaticVarGet(STATIC_VAR_KEY) == LastValue(DateNum()));

Title = EncodeColor(colorWhite) + Name() + " | 1-min | RollOver: " +
        EncodeColor(IIf(firedToday, colorBrightGreen, colorYellow)) +
        IIf(firedToday, "TRIGGERED at 14:47", "Awaiting 14:47...");

_SECTION_END();
