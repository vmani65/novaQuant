<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.13</version>
        <relativePath/>
    </parent>

    <groupId>path.to</groupId>
    <artifactId>nqCore</artifactId>
    <version>2026.05</version>
    <packaging>jar</packaging>

    <name>nqCore</name>
    <description>Spring Boot 3.5.13 + Thymeleaf + JPA (SQLite) — nqCore Application</description>

    <properties>
        <!--
            ┌──────────────────────────────────────────────────────────────────────┐
            │ Planned upgrades — see UPGRADE_PLAN.md at repo root for full plan.   │
            │                                                                      │
            │ Phase A (LOW risk):  java.version 17 → 21  +  ZGC generational      │
            │                      +  spring.threads.virtual.enabled=true         │
            │ Phase B (MED risk):  PositionUtil.LEG_EXEC virtual-thread executor  │
            │                      replaces IntStream.parallel() at 6 service     │
            │                      sites + 2 CompletableFuture margin calls       │
            │ Phase C (LOW risk):  spring-boot-starter-parent 3.5.13 → 4.0.6      │
            │                      (mock-validated 34/34 PASS on 2026-06-01)      │
            │                                                                      │
            │ Each phase ships independently. Read UPGRADE_PLAN.md before doing   │
            │ ANY of them — it includes pre-flight checks, rollback procedures,   │
            │ and a do-NOT-do list.                                                │
            └──────────────────────────────────────────────────────────────────────┘
        -->
        <java.version>21</java.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-thymeleaf</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.hibernate.orm</groupId>
            <artifactId>hibernate-community-dialects</artifactId>
        </dependency>
        <dependency>
            <groupId>com.zerodhatech.kiteconnect</groupId>
            <artifactId>kiteconnect</artifactId>
            <version>4.0.0</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <!--
        Maven build profiles

        Default (no -P flag): mvn clean install
          Includes MockKiteGateway + application-mock.properties.
          Used for local development and Postman testing.

        Production: mvn clean install -Pproduction
          Excludes MockKiteGateway.java from compilation (class absent from JAR).
          Excludes application-mock.properties from classpath.
          Run JAR with env var SPRING_PROFILES_ACTIVE=live
    -->
    <profiles>
        <profile>
            <id>production</id>
            <build>
                <plugins>
                    <!-- Exclude MockKiteGateway from compilation -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-compiler-plugin</artifactId>
                        <configuration>
                            <excludes>
                                <exclude>path/to/_40c/nqCore/gateway/MockKiteGateway.java</exclude>
                            </excludes>
                        </configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.springframework.boot</groupId>
                        <artifactId>spring-boot-maven-plugin</artifactId>
                    </plugin>
                </plugins>
                <!-- Exclude application-mock.properties from the packaged JAR -->
                <resources>
                    <resource>
                        <directory>src/main/resources</directory>
                        <excludes>
                            <exclude>application-mock.properties</exclude>
                            <exclude>application-test.properties</exclude>
                        </excludes>
                    </resource>
                </resources>
            </build>
        </profile>
    </profiles>
</project>
